# Cloudflare static assets: cache headers for the docs Worker. Astro's build files under /_astro have content hashes,
# so browsers keep them for a year. Fonts and images aren't hashed: a week and a day, revalidated in the background.
# The dev build adds an X-Robots-Tag rule at the end (astro.config.mjs).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Security headers on every page and file. Starlight's pages carry inline scripts (theme, sidebar state) and inline
# style attributes, and the search index loads WebAssembly, so those are allowed for this origin only; nothing loads
# from anywhere else, and nothing may frame the docs.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
