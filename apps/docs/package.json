{
  "name": "@aurel/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "deploy": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler deploy",
    "deploy:dev": "AURA_DOCS_SITE=https://aura-dev-docs.aurel-events.workers.dev ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler deploy --env dev",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "latest",
    "@astrojs/starlight": "latest",
    "astro": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "^5.9.3",
    "wrangler": "latest"
  }
}
