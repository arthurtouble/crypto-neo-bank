---
import "@fontsource-variable/archivo";

const flows = [
  {
    intent: "Receive & see",
    product: "Home · Assets · Receive",
    aurel: "Read wallet and protocol state; build one source-labelled portfolio view",
    providers: "Privy wallet + Base",
    state: "live",
  },
  {
    intent: "Send & move",
    product: "Send · Move · Activity",
    aurel: "Check policy, simulate, prepare the exact transaction, then watch receipts",
    providers: "Base + LI.FI + destination chains",
    state: "live",
  },
  {
    intent: "Earn & borrow",
    product: "Earn · Borrow",
    aurel: "Explain risk, prepare Aave actions, and refresh the resulting position",
    providers: "Aave on Base",
    state: "live",
  },
  {
    intent: "Fund & spend",
    product: "Money · Cards · Benefits",
    aurel: "Check eligibility, call provider adapters, process events, and reconcile",
    providers: "Bridge / Rain / benefit vendors",
    state: "planned",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A bird's-eye map of Aurel's product, technology, integrations, and providers." />
    <title>Aurel product map</title>
    <style>
      :root {
        --ink: #14231b;
        --muted: #627067;
        --paper: #f4f3ed;
        --panel: #fffef9;
        --line: #d5dcd6;
        --green: #173f2c;
        --green-2: #2f6a4d;
        --green-soft: #e1ece4;
        --blue-soft: #e2edf2;
        --gold-soft: #f2e8d0;
        --shadow: 0 20px 60px rgba(22, 56, 39, .09);
      }

      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
        line-height: 1.45;
      }

      a { color: inherit; }
      h1, h2, h3, p { margin-top: 0; }
      .shell { width: min(1380px, 100%); margin: 0 auto; padding: 22px; }

      .hero {
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 40px;
        align-items: end;
        padding: 34px 38px;
        border-radius: 24px;
        background: var(--green);
        color: #f7f5ec;
        box-shadow: var(--shadow);
      }

      .topline {
        grid-column: 1 / -1;
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 35px;
        font-size: 12px;
      }

      .brand { font-weight: 650; letter-spacing: .16em; text-transform: uppercase; }
      .back { color: #d8e5dc; text-decoration: none; }
      .back:hover { text-decoration: underline; }
      h1 { margin-bottom: 0; font-size: clamp(44px, 6vw, 82px); line-height: .95; letter-spacing: -.055em; font-weight: 590; }
      .intro { margin: 0; color: #d5e0d8; font-size: clamp(17px, 2vw, 22px); }

      .rule {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin: 16px 0 38px;
        padding: 15px 18px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel);
        font-size: 14px;
      }

      .rule strong { color: var(--green-2); }
      .legend { display: flex; flex: 0 0 auto; gap: 15px; color: var(--muted); font-size: 12px; }
      .key { display: inline-flex; align-items: center; gap: 6px; }
      .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green-2); }
      .dot.planned { background: #a47f35; }

      .section-head { display: flex; justify-content: space-between; gap: 30px; align-items: end; margin-bottom: 18px; }
      .eyebrow { margin-bottom: 6px; color: var(--green-2); font-size: 12px; font-weight: 650; letter-spacing: .13em; text-transform: uppercase; }
      h2 { margin-bottom: 0; font-size: clamp(30px, 4vw, 48px); line-height: 1; letter-spacing: -.04em; font-weight: 570; }
      .section-head p { max-width: 470px; margin-bottom: 0; color: var(--muted); font-size: 14px; }

      .system-map {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--panel);
        box-shadow: var(--shadow);
      }

      .column { position: relative; min-height: 470px; padding: 23px; border-right: 1px solid var(--line); }
      .column:last-child { border-right: 0; }
      .column:not(:last-child)::after {
        content: "→";
        position: absolute;
        z-index: 2;
        top: 53px;
        right: -14px;
        display: grid;
        width: 28px;
        height: 28px;
        place-items: center;
        border-radius: 50%;
        background: var(--green);
        color: white;
        font-size: 14px;
      }

      .column.product { background: linear-gradient(180deg, #edf4ef 0%, var(--panel) 40%); }
      .column.tech { background: linear-gradient(180deg, #edf1f4 0%, var(--panel) 40%); }
      .column.integration { background: linear-gradient(180deg, #f5f0e5 0%, var(--panel) 40%); }
      .column.provider { background: linear-gradient(180deg, #eef0e9 0%, var(--panel) 40%); }
      .column-index { color: var(--muted); font-size: 11px; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
      .column h3 { margin: 13px 0 6px; font-size: 25px; line-height: 1.05; font-weight: 580; }
      .column > p { margin-bottom: 24px; color: var(--muted); font-size: 13px; }
      .items { display: grid; gap: 9px; }
      .item { padding: 12px 13px; border: 1px solid rgba(88, 105, 94, .18); border-radius: 10px; background: rgba(255, 254, 249, .78); }
      .item strong { display: block; margin-bottom: 2px; font-size: 13px; }
      .item span { display: block; color: var(--muted); font-size: 11px; }

      .flows { margin-top: 62px; }
      .flow-table { overflow: hidden; border: 1px solid var(--line); border-radius: 18px; background: var(--panel); }
      .flow-row { display: grid; grid-template-columns: .75fr .9fr 1.45fr 1.05fr; border-top: 1px solid var(--line); }
      .flow-row:first-child { border-top: 0; }
      .flow-row.header { background: var(--green); color: white; }
      .cell { position: relative; min-width: 0; padding: 17px 18px; border-right: 1px solid var(--line); font-size: 13px; }
      .cell:last-child { border-right: 0; }
      .header .cell { border-color: rgba(255,255,255,.15); color: #d8e5dc; font-size: 11px; font-weight: 650; letter-spacing: .1em; text-transform: uppercase; }
      .flow-row:not(.header) .cell:not(:last-child)::after { content: "›"; position: absolute; right: -5px; top: 50%; z-index: 2; transform: translateY(-50%); color: var(--green-2); font-size: 18px; }
      .intent { font-weight: 650; }
      .product-name { color: var(--green-2); font-weight: 600; }
      .provider-name { display: flex; align-items: center; gap: 8px; font-weight: 600; }
      .state { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--green-2); }
      .state.planned { background: #a47f35; }

      .truth {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 18px;
      }

      .truth-step { padding: 18px; border-radius: 14px; background: var(--green); color: white; }
      .truth-step b { display: block; margin-bottom: 5px; font-size: 15px; }
      .truth-step span { color: #c9d9ce; font-size: 12px; }
      .footer { margin-top: 58px; padding: 22px 0; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }

      @media (max-width: 900px) {
        .hero { grid-template-columns: 1fr; }
        .system-map { grid-template-columns: 1fr 1fr; }
        .column { min-height: auto; }
        .column:nth-child(2) { border-right: 0; }
        .column:nth-child(-n+2) { border-bottom: 1px solid var(--line); }
        .column::after { display: none !important; }
        .flow-table { overflow-x: auto; }
        .flow-row { min-width: 850px; }
      }

      @media (max-width: 620px) {
        .shell { padding: 10px; }
        .hero { gap: 25px; padding: 22px; border-radius: 16px; }
        .topline { margin-bottom: 20px; }
        .section-head, .rule { align-items: flex-start; flex-direction: column; }
        .system-map { grid-template-columns: 1fr; }
        .column { border-right: 0; border-bottom: 1px solid var(--line); }
        .column:last-child { border-bottom: 0; }
        .truth { grid-template-columns: 1fr; }
      }

      @media print {
        .back { display: none; }
        .shell { width: auto; padding: 0; }
        .hero, .system-map { box-shadow: none; }
        .flows { margin-top: 35px; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="hero">
        <div class="topline">
          <span class="brand">Aurel / Bird's-eye map</span>
          <a class="back" href="/">Internal knowledge base ↗</a>
        </div>
        <h1>Aurel in one screen.</h1>
        <p class="intro">A customer-controlled interface that connects wallets, chains, DeFi, and regulated financial providers—without pretending Aurel itself holds or settles the money.</p>
      </header>

      <div class="rule" aria-label="Core operating rule and status legend">
        <span><strong>The operating rule:</strong> Aurel prepares and explains. The customer signs. The chain or regulated provider settles.</span>
        <span class="legend"><span class="key"><i class="dot"></i> Live</span><span class="key"><i class="dot planned"></i> Provider-dependent</span></span>
      </div>

      <section id="product" aria-labelledby="map-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">The whole system</p>
            <h2 id="map-heading">Product → technology → integrations → providers</h2>
          </div>
          <p>Read left to right: what the customer sees, what Aurel does, how it connects, and which external system is authoritative.</p>
        </div>

        <div class="system-map">
          <article class="column product">
            <span class="column-index">01 / Customer product</span>
            <h3>One financial workspace</h3>
            <p>The simple surface through which a customer sees and acts on their wealth.</p>
            <div class="items">
              <div class="item"><strong>Home & Assets</strong><span>Unified, source-labelled portfolio</span></div>
              <div class="item"><strong>Receive & Send</strong><span>Wallet funding and direct transfers</span></div>
              <div class="item"><strong>Move</strong><span>Cross-chain USDC routes</span></div>
              <div class="item"><strong>Earn & Borrow</strong><span>Curated Aave positions</span></div>
              <div class="item"><strong>Security & Support</strong><span>Limits, allowlists, recovery, cases</span></div>
              <div class="item"><strong>Money, Cards & Benefits</strong><span>Prepared; provider activation required</span></div>
            </div>
          </article>

          <article class="column tech">
            <span class="column-index">02 / Aurel technology</span>
            <h3>Orchestration layer</h3>
            <p>Turns customer intent into a safe, observable instruction—never an internal money ledger.</p>
            <div class="items">
              <div class="item"><strong>Web app</strong><span>Next/vinext customer and operations UI</span></div>
              <div class="item"><strong>Worker APIs</strong><span>Authentication, adapters, policy, health</span></div>
              <div class="item"><strong>Policy engine</strong><span>Eligibility, limits, cooling, allowlists</span></div>
              <div class="item"><strong>Transaction layer</strong><span>Quotes, simulation, preparation, receipts</span></div>
              <div class="item"><strong>D1 + Queues</strong><span>Evidence, projections, events, retries</span></div>
              <div class="item"><strong>Operations</strong><span>Invites, reconciliation, incidents, switches</span></div>
            </div>
          </article>

          <article class="column integration">
            <span class="column-index">03 / Integrations</span>
            <h3>Stable connection points</h3>
            <p>Provider-specific complexity is isolated behind verified adapters and event handlers.</p>
            <div class="items">
              <div class="item"><strong>Identity & wallet SDK</strong><span>Sign-in, embedded wallet, MFA, recovery</span></div>
              <div class="item"><strong>RPC + contracts</strong><span>Balances, simulations, transactions, receipts</span></div>
              <div class="item"><strong>Route API</strong><span>Cross-chain quotes and source transactions</span></div>
              <div class="item"><strong>Protocol contracts</strong><span>Supply, withdraw, collateral, borrow, repay</span></div>
              <div class="item"><strong>Provider APIs</strong><span>KYC, accounts, transfers, cards, benefits</span></div>
              <div class="item"><strong>Signed webhooks</strong><span>Events, replay protection, reconciliation</span></div>
            </div>
          </article>

          <article class="column provider">
            <span class="column-index">04 / Providers & truth</span>
            <h3>External authorities</h3>
            <p>These systems own identity, signing, settlement, financial state, or infrastructure.</p>
            <div class="items">
              <div class="item"><strong>Privy</strong><span>Identity, wallets, signing, recovery</span></div>
              <div class="item"><strong>Base</strong><span>Primary chain and settlement evidence</span></div>
              <div class="item"><strong>Aave</strong><span>Earn, collateral, debt, health factor</span></div>
              <div class="item"><strong>LI.FI</strong><span>Cross-chain route construction</span></div>
              <div class="item"><strong>Cloudflare</strong><span>Workers, D1, Queues, edge protection</span></div>
              <div class="item"><strong>Bridge / Rain / vendors</strong><span>Fiat, cards, benefits — not yet activated</span></div>
            </div>
          </article>
        </div>
      </section>

      <section class="flows" aria-labelledby="flows-heading">
        <div class="section-head">
          <div>
            <p class="eyebrow">Four customer motions</p>
            <h2 id="flows-heading">How value moves through the system</h2>
          </div>
          <p>Every workflow follows the same pattern: customer intent → Aurel orchestration → customer or provider authorization → external settlement.</p>
        </div>

        <div class="flow-table" role="table" aria-label="Aurel product flows">
          <div class="flow-row header" role="row">
            <div class="cell" role="columnheader">Customer intent</div>
            <div class="cell" role="columnheader">Product surface</div>
            <div class="cell" role="columnheader">What Aurel does</div>
            <div class="cell" role="columnheader">Authority</div>
          </div>
          {flows.map((flow) => (
            <div class="flow-row" role="row">
              <div class="cell intent" role="cell">{flow.intent}</div>
              <div class="cell product-name" role="cell">{flow.product}</div>
              <div class="cell" role="cell">{flow.aurel}</div>
              <div class="cell provider-name" role="cell"><i class:list={["state", flow.state]}></i>{flow.providers}</div>
            </div>
          ))}
        </div>

        <div class="truth" aria-label="Transaction authority model">
          <div class="truth-step"><b>1. Aurel prepares</b><span>Reads state, applies policy, explains risk, and builds the exact action.</span></div>
          <div class="truth-step"><b>2. Customer or provider authorizes</b><span>The customer signs onchain actions; regulated providers approve their own services.</span></div>
          <div class="truth-step"><b>3. External evidence settles</b><span>A chain receipt or provider record—not an Aurel database row—proves completion.</span></div>
        </div>
      </section>

      <footer class="footer">Aurel internal product map · Detailed implementation, security, operations, and launch procedures remain in the knowledge base.</footer>
    </main>
  </body>
</html>
