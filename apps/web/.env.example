# Create an application at https://dashboard.privy.io and use its public app ID.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Local development is isolated in Wrangler/Miniflare. Production is configured in wrangler.jsonc.
PRODUCT_ENVIRONMENT=development

# Keep the product in demo mode until Bridge production access is contractually approved.
NEXT_PUBLIC_PRODUCT_MODE=demo

# Local webhook testing only. Store production values with `wrangler secret put`.
PROVIDER_WEBHOOK_SECRET=

# Optional locally. Production enforcement starts only when both values are configured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
