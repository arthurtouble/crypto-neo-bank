# Local development runs in Wrangler/Miniflare. Deployed values live in wrangler.jsonc
# (non-secret) and `wrangler secret put` (secret). Never commit real values.

# Privy: sign-in, the embedded signer, and smart wallets. https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Svix signing secret (whsec_...) for Privy webhooks. Unset means /api/webhooks/privy is off.
PRIVY_WEBHOOK_SECRET=

PRODUCT_ENVIRONMENT=development

# Bridge: bank accounts and payouts. Commands run only with this key set AND the
# fiat_accounts feature switch on. Use Bridge's sandbox URL and key until approval.
BRIDGE_API_BASE_URL=https://api.bridge.xyz/v0
BRIDGE_API_KEY=
# The PEM public key of the Bridge webhook endpoint. Unset means /api/webhooks/bridge is off.
BRIDGE_WEBHOOK_PUBLIC_KEY=

# Cards: Stripe Issuing with Bridge. Cards work only with these set AND the
# payment_cards feature switch on (card_wallets adds Apple Pay and Google Pay).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# The Stripe webhook endpoint's signing secret (whsec_...). Unset means /api/webhooks/stripe is off.
STRIPE_WEBHOOK_SECRET=
# Bridge's card contract on Base, which the customer's USDC allowance is granted to.
BRIDGE_CARDS_SPENDER=

# LI.FI routes for swaps, invest, and cross-chain moves. The fee is a fraction (0.0025 = 0.25%).
LIFI_INTEGRATOR=aurel
LIFI_INTEGRATOR_FEE=0
LIFI_API_KEY=

# Optional locally. Enforcement starts only when both values are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
