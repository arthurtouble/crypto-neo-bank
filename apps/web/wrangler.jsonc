{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurel-financial-os",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  // Advances open money actions from chain evidence (worker/index.ts).
  "triggers": { "crons": ["*/2 * * * *"] },
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    "PRODUCT_ENVIRONMENT": "production",
    "PRODUCT_MODE": "mainnet-preview",
    "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
    // Cloudflare Access for the operations app (apps/ops): the team domain and the ops application's audience tag. Empty refuses every operator.
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "LIFI_INTEGRATOR": "aurel",
    "LIFI_INTEGRATOR_FEE": "0"
    // Still to set before launch (docs/operations/production-launch.md, pnpm production:check): a production Privy app ID,
    // the Access values above, EMAIL_FROM, APP_ORIGIN, VAPID_PUBLIC_KEY, and INTERCOM_APP_ID.
  },
  "secrets": {
    "required": ["PRIVY_APP_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "PROJECTION_DB",
      "database_name": "aurel-projections",
      "database_id": "30075b2d-3f76-442c-a3b6-05cea1032137",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PROVIDER_EVENTS", "queue": "aurel-provider-events" }
    ]
  },
  "env": {
    "dev": {
      "name": "aura-dev",
      // Names only: the values are set with `wrangler secret put --env dev`, never here. A deploy fails if one is missing.
      "secrets": {
        "required": ["PRIVY_APP_SECRET", "RESEND_API_KEY", "RESEND_WEBHOOK_SECRET", "VAPID_PRIVATE_KEY", "LIFI_API_KEY", "INTERCOM_IDENTITY_SECRET", "FIN_CONNECTOR_TOKEN",
          "MARKETS_CREDENTIAL_KEY", "POLYMARKET_BUILDER_API_KEY", "POLYMARKET_BUILDER_SECRET", "POLYMARKET_BUILDER_PASSPHRASE"]
      },
      "vars": {
        "PRODUCT_ENVIRONMENT": "development",
        "PRODUCT_MODE": "mainnet-preview",
        "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
        "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
        // Cloudflare Access in front of aura-dev-ops (the dev operations app). Not secrets: the team domain and the application's audience tag.
        "CF_ACCESS_TEAM_DOMAIN": "https://red-surf-47a8.cloudflareaccess.com",
        "CF_ACCESS_AUD": "f6cf8daf909aeae2ca6f06629b529c9068df1a567bac7c89f95a7899fd64b289",
        "LIFI_INTEGRATOR": "aurel",
        "LIFI_INTEGRATOR_FEE": "0",
        // Notifications. Resend only sends from onboarding@resend.dev, to the Resend account's own address, until a domain is verified.
        "EMAIL_FROM": "Aura <onboarding@resend.dev>",
        "APP_ORIGIN": "https://aura-dev.aurel-events.workers.dev",
        "VAPID_PUBLIC_KEY": "BKy2yu17XoDp4trj5IYoWspZslphAaCT4v7wrfVdHj9DdNh46tispIXt2YHqt5VRw263I6zHh7C8hQWZWLCJUhI",
        // Support chat. The identity-verification secret is the INTERCOM_IDENTITY_SECRET secret.
        "INTERCOM_APP_ID": "rn8vf9xv",
        // Not a secret: Polymarket attaches it to every order Aura places, publicly.
        "POLYMARKET_BUILDER_CODE": "0x4be5ac607b12fe17ffe01acc0c3c73e09c3acd5ea099b6a3dce3e33f299ead16"
      },
      "d1_databases": [{
        "binding": "PROJECTION_DB",
        "database_name": "aura-dev-projections",
        "database_id": "27acaa63-44c8-4422-9b32-f4f78c35aabd",
        "migrations_dir": "../../infra/d1/migrations"
      }],
      "queues": { "producers": [{ "binding": "PROVIDER_EVENTS", "queue": "aura-dev-provider-events" }] },
      "triggers": { "crons": ["*/2 * * * *"] },
      "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
