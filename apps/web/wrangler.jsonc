{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurel-financial-os",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    "PRODUCT_ENVIRONMENT": "production",
    "PRODUCT_MODE": "mainnet-preview",
    "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE_LD5ONaf0OITS8",
    "TURNSTILE_HOSTNAMES": "aurel-financial-os.aurel-events.workers.dev",
    "ADMIN_PRIVY_SUBJECTS": "",
    "REQUIRE_CF_ACCESS": "false"
  },
  "secrets": {
    "required": ["PRIVY_APP_SECRET", "TURNSTILE_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "PROJECTION_DB",
      "database_name": "aurel-projections",
      "database_id": "30075b2d-3f76-442c-a3b6-05cea1032137",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PROVIDER_EVENTS", "queue": "aurel-provider-events" }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "dev": {
      "name": "aura-dev",
      "vars": {
        "PRODUCT_ENVIRONMENT": "development",
        "PRODUCT_MODE": "mainnet-preview",
        "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
        "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_HOSTNAMES": "aura-dev.aurel-events.workers.dev,localhost",
        "ADMIN_PRIVY_SUBJECTS": "",
        "LIFI_INTEGRATOR": "aurel",
        "LIFI_INTEGRATOR_FEE": "0",
        "REQUIRE_CF_ACCESS": "false"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET"]
      },
      "d1_databases": [{
        "binding": "PROJECTION_DB",
        "database_name": "aura-dev-projections",
        "database_id": "27acaa63-44c8-4422-9b32-f4f78c35aabd",
        "migrations_dir": "../../infra/d1/migrations"
      }],
      "queues": { "producers": [{ "binding": "PROVIDER_EVENTS", "queue": "aura-dev-provider-events" }] },
      "ai": { "binding": "AI" },
      "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
