{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurel-financial-os",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "vars": {
    "PRODUCT_ENVIRONMENT": "production",
    "PRODUCT_MODE": "mainnet-preview",
    "BRIDGE_MODE": "preview",
    "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAE_LD5ONaf0OITS8",
    "TURNSTILE_HOSTNAMES": "aurel-financial-os.aurel-events.workers.dev",
    "ADMIN_PRIVY_SUBJECTS": "",
    "BETA_ACCESS_MODE": "preview",
    "BETA_ALLOWED_COUNTRIES": "",
    "REQUIRE_CF_ACCESS": "false",
    "PROVIDER_WEBHOOK_TOLERANCE_SECONDS": "300"
  },
  "secrets": {
    "required": ["PROVIDER_WEBHOOK_SECRET", "PRIVY_APP_SECRET", "TURNSTILE_SECRET", "GROWTH_EMAIL_ENCRYPTION_KEY", "GROWTH_EMAIL_LOOKUP_KEY"]
  },
  "d1_databases": [
    {
      "binding": "PROJECTION_DB",
      "database_name": "aurel-projections",
      "database_id": "30075b2d-3f76-442c-a3b6-05cea1032137",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "PROVIDER_EVENTS", "queue": "aurel-provider-events" }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "dev": {
      "name": "aura-dev",
      "vars": {
        "PRODUCT_ENVIRONMENT": "development",
        "PRODUCT_MODE": "mainnet-preview",
        "BRIDGE_MODE": "preview",
        "BRIDGE_API_BASE_URL": "https://api.bridge.xyz/v0",
        "NEXT_PUBLIC_PRIVY_APP_ID": "cmub5evr4013l0cjs0w5dijlb",
        "NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "TURNSTILE_HOSTNAMES": "aura-dev.aurel-events.workers.dev,localhost",
        "ADMIN_PRIVY_SUBJECTS": "",
        "BETA_ACCESS_MODE": "invite",
        "BETA_ALLOWED_COUNTRIES": "AD,AE,AF,AG,AI,AL,AM,AO,AQ,AR,AS,AT,AU,AW,AX,AZ,BA,BB,BD,BE,BF,BG,BH,BI,BJ,BL,BM,BN,BO,BQ,BR,BS,BT,BV,BW,BY,BZ,CA,CC,CD,CF,CG,CH,CI,CK,CL,CM,CN,CO,CR,CU,CV,CW,CX,CY,CZ,DE,DJ,DK,DM,DO,DZ,EC,EE,EG,EH,ER,ES,ET,FI,FJ,FK,FM,FO,FR,GA,GB,GD,GE,GF,GG,GH,GI,GL,GM,GN,GP,GQ,GR,GS,GT,GU,GW,GY,HK,HM,HN,HR,HT,HU,ID,IE,IL,IM,IN,IO,IQ,IR,IS,IT,JE,JM,JO,JP,KE,KG,KH,KI,KM,KN,KP,KR,KW,KY,KZ,LA,LB,LC,LI,LK,LR,LS,LT,LU,LV,LY,MA,MC,MD,ME,MF,MG,MH,MK,ML,MM,MN,MO,MP,MQ,MR,MS,MT,MU,MV,MW,MX,MY,MZ,NA,NC,NE,NF,NG,NI,NL,NO,NP,NR,NU,NZ,OM,PA,PE,PF,PG,PH,PK,PL,PM,PN,PR,PS,PT,PW,PY,QA,RE,RO,RS,RU,RW,SA,SB,SC,SD,SE,SG,SH,SI,SJ,SK,SL,SM,SN,SO,SR,SS,ST,SV,SX,SY,SZ,TC,TD,TF,TG,TH,TJ,TK,TL,TM,TN,TO,TR,TT,TV,TW,TZ,UA,UG,UM,US,UY,UZ,VA,VC,VE,VG,VI,VN,VU,WF,WS,YE,YT,ZA,ZM,ZW",
        "AUREL_LIFI_ALLOWED_TOOLS": "across,feecollection",
        "AUREL_LIFI_ALLOWED_BRIDGES": "across",
        "AUREL_SWAP_ALLOWED_TARGETS": "0x1231deb6f5749ef6ce6943a275a1d3e7486f4eae",
        "AUREL_SWAP_ALLOWED_SPENDERS": "0x1231deb6f5749ef6ce6943a275a1d3e7486f4eae",
        "AUREL_SWAP_EXECUTION_POLICY": "{\"diamond\":\"0x1231deb6f5749ef6ce6943a275a1d3e7486f4eae\",\"feeForwarder\":\"0xce40449b773a3e6e5e769adb4e567179d4828cbd\",\"feeRecipients\":[\"0xc06ebbefd94032b85424d51906e2a335efae264b\"],\"routerSpenders\":[]}",
        "REQUIRE_CF_ACCESS": "false",
        "PROVIDER_WEBHOOK_TOLERANCE_SECONDS": "300"
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET"]
      },
      "d1_databases": [{
        "binding": "PROJECTION_DB",
        "database_name": "aura-dev-projections",
        "database_id": "27acaa63-44c8-4422-9b32-f4f78c35aabd",
        "migrations_dir": "../../infra/d1/migrations"
      }],
      "queues": { "producers": [{ "binding": "PROVIDER_EVENTS", "queue": "aura-dev-provider-events" }] },
      "ai": { "binding": "AI" },
      "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
