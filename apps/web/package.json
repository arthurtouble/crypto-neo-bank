{
  "name": "@aurel/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "preview": "vinext start",
    "deploy": "vinext-cloudflare deploy",
    "deploy:dry-run": "vinext-cloudflare deploy --dry-run",
    "release:upload": "vinext build && wrangler versions upload --tag candidate",
    "release:list": "wrangler versions list",
    "release:rollback": "wrangler rollback",
    "cf-types": "wrangler types --env-interface CloudflareEnv",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:live:readonly": "AUREL_LIVE_READONLY=1 vitest run",
    "test:e2e": "pnpm build && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.2",
    "@fontsource-variable/archivo": "latest",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "latest",
    "@privy-io/wagmi": "^4.0.17",
    "@radix-ui/react-dialog": "^1.1.15",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "^5.103.1",
    "canonicalize": "2.1.0",
    "eventemitter3": "5.0.4",
    "fetch-retry": "6.0.0",
    "lucide-react": "latest",
    "next": "latest",
    "pino": "^10.0.0",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "viem": "^2.56.8",
    "wagmi": "^3.7.7",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "latest",
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vinext/cloudflare": "latest",
    "@vitejs/plugin-rsc": "latest",
    "eslint": "^9.39.2",
    "eslint-config-next": "latest",
    "react-server-dom-webpack": "latest",
    "typescript": "^5.9.3",
    "vinext": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
