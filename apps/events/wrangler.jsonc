{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aurel-provider-event-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "PROJECTION_DB",
      "database_name": "aurel-projections",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "aurel-provider-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "aurel-provider-events-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
