{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aurel-provider-event-consumer",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // This Worker only consumes queues and runs crons; nothing needs its public workers.dev address in production.
  // Wrangler environments inherit this setting, so dev turns it back on below to stay as it was.
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "PROJECTION_DB",
      "database_name": "aurel-projections",
      "database_id": "30075b2d-3f76-442c-a3b6-05cea1032137",
      "migrations_dir": "../../infra/d1/migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "aurel-provider-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "aurel-provider-events-dlq"
      },
      {
        "queue": "aurel-provider-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 2
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "dev": {
      "name": "aura-dev-provider-event-consumer",
      "workers_dev": true,
      "d1_databases": [{
        "binding": "PROJECTION_DB",
        "database_name": "aura-dev-projections",
        "database_id": "27acaa63-44c8-4422-9b32-f4f78c35aabd",
        "migrations_dir": "../../infra/d1/migrations"
      }],
      "queues": {
        "consumers": [
          { "queue": "aura-dev-provider-events", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 5, "dead_letter_queue": "aura-dev-provider-events-dlq" },
          { "queue": "aura-dev-provider-events-dlq", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 2 }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
    }
  }
}
