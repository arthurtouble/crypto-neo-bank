{
  "name": "aurel-financial-os",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @aurel/web dev",
    "build": "pnpm --filter @aurel/web build",
    "preview": "pnpm --filter @aurel/web preview",
    "deploy": "pnpm --filter @aurel/web deploy",
    "deploy:dev": "pnpm --filter @aurel/web deploy:dev",
    "deploy:dry-run": "pnpm --filter @aurel/web deploy:dry-run",
    "release:upload": "pnpm --filter @aurel/web release:upload",
    "release:list": "pnpm --filter @aurel/web release:list",
    "release:rollback": "pnpm --filter @aurel/web release:rollback",
    "events:dev": "pnpm --filter @aurel/events dev",
    "events:deploy": "pnpm --filter @aurel/events deploy",
    "events:deploy:dev": "pnpm --filter @aurel/events deploy:dev",
    "docs:dev": "pnpm --filter @aurel/docs dev",
    "docs:build": "pnpm --filter @aurel/docs build",
    "docs:deploy": "pnpm --filter @aurel/docs deploy",
    "docs:deploy:dev": "pnpm --filter @aurel/docs deploy:dev",
    "test": "pnpm --filter @aurel/web test",
    "test:unit": "pnpm --filter @aurel/web test:unit && pnpm --filter @aurel/ops test && node --test scripts/mainnet-readiness.test.mjs scripts/check-assets.test.mjs scripts/production-check.test.mjs scripts/e2e-select.test.mjs scripts/check-copy.test.mjs",
    "test:e2e": "pnpm --filter @aurel/web test:e2e",
    "test:mainnet-readiness": "node scripts/mainnet-readiness.mjs",
    "test:live:readonly": "pnpm --filter @aurel/web test:live:readonly",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "test:recovery": "bash scripts/recovery-drill.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "deploy:dev:all": "bash scripts/deploy-dev.sh",
    "d1:reset:dev": "bash scripts/d1-reset-dev.sh",
    "marketing:check": "node scripts/check-marketing-claims.mjs",
    "sweep": "AURA_SWEEP=${AURA_SWEEP:-report} pnpm --filter @aurel/web exec playwright test tests/e2e/sweep.spec.ts --project desktop-chromium; node scripts/sweep-report.mjs",
    "sweep:report": "node scripts/sweep-report.mjs",
    "copy:check": "node scripts/check-copy.mjs",
    "typecheck": "pnpm --filter @aurel/web typecheck",
    "typecheck:all": "pnpm -r typecheck",
    "lint": "pnpm --filter @aurel/web lint",
    "assets:check": "node scripts/check-assets.mjs",
    "production:check": "node scripts/production-check.mjs",
    "ops:dev": "pnpm --filter @aurel/ops dev",
    "ops:deploy:dev": "pnpm --filter @aurel/ops deploy:dev"
  }
}
