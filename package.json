{
  "name": "aurel-financial-os",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @aurel/web dev",
    "build": "pnpm --filter @aurel/web build",
    "preview": "pnpm --filter @aurel/web preview",
    "deploy": "pnpm --filter @aurel/web deploy",
    "deploy:dry-run": "pnpm --filter @aurel/web deploy:dry-run",
    "release:upload": "pnpm --filter @aurel/web release:upload",
    "release:list": "pnpm --filter @aurel/web release:list",
    "release:rollback": "pnpm --filter @aurel/web release:rollback",
    "events:dev": "pnpm --filter @aurel/events dev",
    "events:deploy": "pnpm --filter @aurel/events deploy",
    "test": "pnpm --filter @aurel/web test",
    "test:unit": "pnpm --filter @aurel/web test:unit",
    "test:e2e": "pnpm --filter @aurel/web test:e2e",
    "typecheck": "pnpm --filter @aurel/web typecheck",
    "typecheck:all": "pnpm -r typecheck",
    "lint": "pnpm --filter @aurel/web lint"
  }
}
